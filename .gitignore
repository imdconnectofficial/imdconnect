# ==============================================================================
# ImdConnect — Comprehensive Git Ignore & Zero-Secret Protection Policy
# Strict Enforcement: NEVER commit secrets, private tokens, or service-role keys.
# ==============================================================================

# 1. Environment & Secrets (NEVER COMMIT)
.env*
.env
.env.*
!.env.example
*.env
*.local
.secret*
*.secret
*.secrets
secrets/
credentials/
credentials.json
service_account*.json

# 2. Supabase Service Role & Backend Secret Protection
*service_role*
*service-role*
supabase/.temp/
supabase/.branches/
.supabase/

# 3. Cryptographic Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.der
*.pk8
*.ppk
*.kdbx
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
jwt.key
jwt.secret
*.token
tokens.json

# 4. Database Credentials & Storage Dumps
*.sql.dump
*.dump
*.sqlite
*.sqlite3
*.db
database.json

# 5. SMTP & Mail Credentials
*.smtp
smtp.json
mail.json

# 6. Cloudflare & Serverless Local Configs
.wrangler/
wrangler.toml.local
wrangler.json.local

# 7. Dependency Directories (Local Development Tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. Build, Cache & Output Artifacts
dist/
build/
out/
.cache/

# 9. Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 10. Editor & IDE Settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# 11. Temporary Files, Logs & Testing Browser Profiles
*.log
*.tmp
*.temp
tmp/
temp/
tests/.chrome_*
tests/.chrome_*/**
tests/screenshots/
tests/screenshots/**
