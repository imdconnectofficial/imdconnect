# ==============================================================================
# ImdConnect — Git Ignore Rules & Secret Protection
# ==============================================================================

# 1. Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.local
*.secret
*.secrets
secrets/
credentials/

# 2. Supabase Specific Secrets & Service Role Protection
*service_role*
*service-role*
supabase/.temp/
supabase/.branches/
.supabase/

# 3. Cryptographic Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*

# 4. Dependency Directories (if build tools are used in local dev)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Build & Output Directories
dist/
build/
out/
.cache/

# 6. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. Editor & IDE Settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# 8. Temporary Files & Logs
*.log
*.tmp
*.temp
tmp/
temp/
