{
  "name": "ImdConnect — Connect Privately. Chat Freely.",
  "short_name": "ImdConnect",
  "description": "High-performance, username-based, encrypted text messaging platform.",
  "start_url": "./#/app",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0F172A",
  "theme_color": "#2563EB",
  "categories": [
    "social",
    "communication",
    "security",
    "messaging"
  ],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "./assets/icons/favicon.svg",
      "sizes": "64x64",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Recent Chats",
      "short_name": "Chats",
      "description": "View recent conversations and messages",
      "url": "./#/chats",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Friends",
      "short_name": "Friends",
      "description": "Find and manage friend requests",
      "url": "./#/friends",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Groups",
      "short_name": "Groups",
      "description": "Access your group chats",
      "url": "./#/groups",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
